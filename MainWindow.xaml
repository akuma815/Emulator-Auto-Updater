<Window x:Class="EmulatorAutoUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Assets/EmulatorAutoUpdater.ico"
        Width="1520"
        Height="960"
        MinWidth="1400"
        MinHeight="900"
        Background="#F1F5F9"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <CollectionViewSource x:Key="EmulatorCollectionViewSource" Source="{Binding Emulators}">
            <CollectionViewSource.SortDescriptions>
                <componentModel:SortDescription PropertyName="Name" Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <!-- Base Control Colors & Brushes -->
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0F172A" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
        <SolidColorBrush x:Key="SuccessHoverBrush" Color="#047857" />
        <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626" />

        <!-- Card Container Style -->
        <Style x:Key="CardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <!-- Section Header Text Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Standard Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button Style (Indigo) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3730A3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button Style (Emerald Green) -->
        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource SuccessHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#065F46" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style (Rose Red) -->
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FEF2F2" />
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource DangerHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#475569" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EEF2FF" />
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern ProgressBar Style -->
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="TemplateRoot">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Rectangle x:Name="PART_Track" />
                            <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Border Background="{TemplateBinding Foreground}" CornerRadius="4" />
                            </Decorator>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar Card -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Downloads & Status Card -->
            <RowDefinition Height="260" />
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Margin="0,0,12,0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Image Source="pack://application:,,,/Assets/EmulatorAutoUpdater.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Emulator Auto Updater" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" />
                        <Border Background="#4F46E5" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.2.0" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource AppSubtitle}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Main Fast Global Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Language Selector -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource LabelLanguage}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding SupportedLanguages}"
                              SelectedValue="{Binding SelectedLanguageCode, Mode=TwoWay}"
                              SelectedValuePath="Code"
                              DisplayMemberPath="NativeName"
                              Width="100" Height="32" VerticalContentAlignment="Center"
                              FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
                <Button Content="{DynamicResource BtnAppUpdateAvailable}" Command="{Binding PerformAppSelfUpdateCommand}" Visibility="{Binding IsAppUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource DangerButtonStyle}" Height="36" Margin="4,0" Padding="12,0" ToolTip="{Binding AppUpdateBannerText}" />
                <Button Content="{Binding CheckAllUpdatesButtonText}" Command="{Binding CheckAllUpdatesCommand}" Style="{StaticResource SuccessButtonStyle}" MinWidth="160" Height="36" Margin="4,0" ToolTip="{DynamicResource TipCheckAllUpdates}" />
                <Button Content="{Binding DownloadAllUpdatesButtonText}" Command="{Binding DownloadAllUpdatesCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" Height="36" Margin="4,0" ToolTip="{DynamicResource TipDownloadAllUpdates}" />
            </StackPanel>
        </Grid>

        <!-- 2. Action Toolbar Card -->
        <Border Grid.Row="1" Style="{StaticResource CardPanelStyle}" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Emulator & Config File Management Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Group 1: Emulator Items -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource LblEmulatorGroup}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="{DynamicResource BtnAddEmulator}" Command="{Binding AddEmulatorCommand}" MinWidth="110" />
                        <Button Content="{DynamicResource BtnDeleteSelected}" Command="{Binding RemoveEmulatorCommand}" Style="{StaticResource DangerButtonStyle}" MinWidth="85" />
                        <Separator Width="1" Height="20" Background="#E2E8F0" Margin="12,0" />
                    </StackPanel>

                    <!-- Group 2: Config Management -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource LblConfigFileGroup}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                        <Button Content="{DynamicResource BtnLoadSettings}" Command="{Binding LoadSettingsCommand}" MinWidth="95" />
                        <Button Content="{DynamicResource BtnSaveSettings}" Command="{Binding SaveSettingsCommand}" MinWidth="85" />
                        <Button Content="{DynamicResource BtnOpenConfigFile}" Command="{Binding OpenConfigFileCommand}" MinWidth="115" />
                        <Button Content="{DynamicResource BtnSaveConfigFileAs}" Command="{Binding SaveConfigFileAsCommand}" MinWidth="130" />
                    </StackPanel>
                </Grid>

                <Separator Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="#E2E8F0" Margin="0,4,0,0" />

                <!-- Row 1: Global Automation Options & Default Asset Pattern -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Group 3: CheckBoxes -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{DynamicResource ChkCheckAllOnStartup}"
                                  IsChecked="{Binding CheckAllUpdatesOnStartup, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  FontSize="12" />
                        <CheckBox Content="{DynamicResource ChkUseVersionSubfolders}"
                                  IsChecked="{Binding UseVersionSubfolders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,20,0"
                                  Foreground="{StaticResource PrimaryTextBrush}"
                                  FontSize="12"
                                  ToolTip="{DynamicResource TipUseVersionSubfolders}" />
                    </StackPanel>

                    <!-- Group 4: Default Pattern Settings -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{DynamicResource LblDefaultAssetPattern}" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11" />
                        <TextBox Text="{Binding DefaultAssetPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="240" Margin="0,0,6,0" />
                        <Button Content="{DynamicResource BtnConvertPattern}" Command="{Binding ConvertDefaultAssetPatternCommand}" MinWidth="80" ToolTip="{DynamicResource TipConvertDefaultPattern}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. Main Content Split View -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Emulator DataGrid Card -->
            <Border Grid.Column="0" Style="{StaticResource CardPanelStyle}" Margin="0,0,6,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource HeaderEmulatorList}" Style="{StaticResource SectionHeaderStyle}" />

                    <DataGrid x:Name="EmulatorDataGrid"
                              Grid.Row="1"
                              ItemsSource="{Binding Source={StaticResource EmulatorCollectionViewSource}}"
                              SelectedItem="{Binding SelectedEmulator, Mode=TwoWay}"
                              ColumnHeaderDragCompleted="EmulatorDataGrid_ColumnHeaderDragCompleted"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="False"
                              HorizontalScrollBarVisibility="Disabled"
                              RowHeaderWidth="0">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource MenuManageSubfolders}"
                                          Click="ManageSubfolders_Click"
                                          ToolTip="{DynamicResource TipManageSubfolders}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusType}" Value="UpdateAvailable">
                                        <Setter Property="Background" Value="#F0FDF4" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusType}" Value="CheckFailed">
                                        <Setter Property="Background" Value="#FEF2F2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusType}" Value="Checking">
                                        <Setter Property="Background" Value="#FEFCE8" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusType}" Value="Downloading">
                                        <Setter Property="Background" Value="#EEF2FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource ColEmulatorName}" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" MinWidth="100" />
                            
                            <!-- Status Pill Badge Column -->
                            <DataGridTemplateColumn Header="{DynamicResource ColStatus}" Width="1.6*" MinWidth="135" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F1F5F9" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusType}" Value="UpdateAvailable">
                                                            <Setter Property="Background" Value="#DEF7EC" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusType}" Value="UpToDate">
                                                            <Setter Property="Background" Value="#E1EFFE" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusType}" Value="CheckFailed">
                                                            <Setter Property="Background" Value="#FDE8E8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusType}" Value="Checking">
                                                            <Setter Property="Background" Value="#FEF08A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusType}" Value="Downloading">
                                                            <Setter Property="Background" Value="#E0E7FF" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="11" FontWeight="Bold" Margin="0,0,5,0" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="➖" />
                                                            <Setter Property="Foreground" Value="#64748B" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="UpdateAvailable">
                                                                    <Setter Property="Text" Value="⚡" />
                                                                    <Setter Property="Foreground" Value="#03543F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="UpToDate">
                                                                    <Setter Property="Text" Value="✓" />
                                                                    <Setter Property="Foreground" Value="#1E429F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="CheckFailed">
                                                                    <Setter Property="Text" Value="⚠️" />
                                                                    <Setter Property="Foreground" Value="#9B1C1C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="Checking">
                                                                    <Setter Property="Text" Value="🔍" />
                                                                    <Setter Property="Foreground" Value="#713F12" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="Downloading">
                                                                    <Setter Property="Text" Value="⬇️" />
                                                                    <Setter Property="Foreground" Value="#3730A3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#475569" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="UpdateAvailable">
                                                                    <Setter Property="Foreground" Value="#03543F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="UpToDate">
                                                                    <Setter Property="Foreground" Value="#1E429F" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="CheckFailed">
                                                                    <Setter Property="Foreground" Value="#9B1C1C" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="Checking">
                                                                    <Setter Property="Foreground" Value="#713F12" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StatusType}" Value="Downloading">
                                                                    <Setter Property="Foreground" Value="#3730A3" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{DynamicResource ColRepository}" Binding="{Binding Repository, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="2.2*" MinWidth="130" />
                            <DataGridTextColumn Header="{DynamicResource ColInstallPath}" Binding="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.8*" MinWidth="110" />
                            <DataGridTextColumn Header="{DynamicResource ColAssetPattern}" Binding="{Binding AssetPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.8*" MinWidth="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right Pane: Selected Emulator Detail & Release Info Card -->
            <Border Grid.Column="1" Style="{StaticResource CardPanelStyle}" Margin="6,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{DynamicResource HeaderEmulatorDetail}" Style="{StaticResource SectionHeaderStyle}" />

                    <!-- Form Inputs Grid -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Name -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LblDetailName}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEmulator.Name, FallbackValue=-}" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Repository -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LblDetailRepo}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEmulator.Repository, FallbackValue=-}" Foreground="{StaticResource PrimaryTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Target Folder -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LblDetailFolder}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />
                        <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,2">
                            <Button Content="{DynamicResource BtnBrowseFolder}" Command="{Binding BrowseFolderCommand}" DockPanel.Dock="Right" Width="85" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding SelectedEmulator.Folder, FallbackValue=-}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                        </DockPanel>

                        <!-- Asset Pattern -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource LblDetailPattern}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />
                        <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,2">
                            <Button Content="{DynamicResource BtnAutoConvertPattern}" Command="{Binding ConvertSelectedAssetPatternCommand}" DockPanel.Dock="Right" Width="105" Margin="4,0,0,0" ToolTip="{DynamicResource TipAutoConvertPattern}" />
                            <TextBox Text="{Binding SelectedEmulator.AssetPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Installed Version -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LblDetailInstalledVersion}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedEmulator.InstalledVersion, FallbackValue=-}" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />

                        <!-- Last Downloaded -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource LblDetailLastDownloaded}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedEmulator.LastDownloadedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}, TargetNullValue=-}" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,4" />
                    </Grid>

                    <!-- Individual Emulator Actions -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                        <UniformGrid Columns="4">
                            <Button Content="{DynamicResource BtnCheckUpdate}" Command="{Binding CheckUpdatesCommand}" Style="{StaticResource SuccessButtonStyle}" Height="34" Margin="2" />
                            <Button Content="{DynamicResource BtnDownloadOnly}" Command="{Binding DownloadOnlyCommand}" Height="34" Margin="2" />
                            <Button Content="{DynamicResource BtnDownloadAndExtract}" Command="{Binding DownloadUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="2" />
                            <Button Content="{DynamicResource BtnManageSubfolders}" Click="ManageSubfolders_Click" Style="{StaticResource SecondaryButtonStyle}" Height="34" Margin="2" ToolTip="{DynamicResource TipManageSubfolders}" />
                        </UniformGrid>
                    </Border>

                    <!-- Release Notes Card Section -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource LblLatestReleaseVersion}" FontWeight="Bold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedReleaseVersion, FallbackValue=-}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>

                        <TextBox Grid.Row="1"
                                 Text="{Binding ReleaseNotes}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="#F8FAFC"
                                 BorderBrush="#E2E8F0"
                                 Padding="8" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Downloads & Status Card -->
        <Border Grid.Row="3" Style="{StaticResource CardPanelStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>

                <!-- Downloadable Assets List -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource HeaderDownloadedFiles}" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{DynamicResource BtnCopyFileName}" Command="{Binding CopySelectedAssetNameCommand}" Padding="8,3" FontSize="11" Margin="0,0,4,0" ToolTip="{DynamicResource TipCopyFileName}" />
                            <Button Content="{DynamicResource BtnApplyToPattern}" Command="{Binding ApplySelectedAssetToPatternCommand}" Style="{StaticResource SuccessButtonStyle}" Padding="8,3" FontSize="11" Margin="0,0,4,0" ToolTip="{DynamicResource TipApplyToPattern}" />
                            <Button Content="{DynamicResource BtnExcludeFromPattern}" Command="{Binding ExcludeSelectedAssetFromPatternCommand}" Style="{StaticResource DangerButtonStyle}" Padding="8,3" FontSize="11" Margin="0" ToolTip="{DynamicResource TipExcludeFromPattern}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ReleaseAssets}"
                              SelectedItem="{Binding SelectedAsset, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              RowHeaderWidth="0">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource MenuCopyFileName}" Command="{Binding CopySelectedAssetNameCommand}" />
                                <MenuItem Header="{DynamicResource MenuApplyToPattern}" Command="{Binding ApplySelectedAssetToPatternCommand}" />
                                <MenuItem Header="{DynamicResource MenuExcludeFromPattern}" Command="{Binding ExcludeSelectedAssetFromPatternCommand}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{DynamicResource ColFileName}" Binding="{Binding AssetName}" Width="3*" />
                            <DataGridTextColumn Header="{DynamicResource ColVersionTag}" Binding="{Binding Version}" Width="1.2*" />
                            <DataGridTextColumn Header="{DynamicResource ColPublishDate}" Binding="{Binding PublishedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.5*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- Progress & Unified Activity Log Console Card -->
                <Border Grid.Column="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header: Title & Clear Log Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="{DynamicResource HeaderLogConsole}" Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" />
                            <Button Content="{DynamicResource BtnClearLog}" Command="{Binding ClearLogCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3" FontSize="11" Margin="0" />
                        </Grid>

                        <!-- Clean Progress Bar & Percentage -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Grid.Column="0" Height="14" Value="{Binding Progress}" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" />
                        </Grid>

                        <!-- Scrollable Log Console -->
                        <TextBox x:Name="ActivityLogTextBox"
                                 Grid.Row="2"
                                 Text="{Binding ActivityLogText}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="ActivityLogTextBox_TextChanged"
                                 Background="#FFFFFF"
                                 BorderBrush="#CBD5E1"
                                 Foreground="#334155"
                                 FontFamily="Consolas, Segoe UI, Malgun Gothic"
                                 FontSize="11"
                                 Padding="6"
                                 Margin="0,0,0,6" />

                        <!-- Current Config Path Footer -->
                        <StackPanel Grid.Row="3" VerticalAlignment="Bottom">
                            <Separator Background="#E2E8F0" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding CurrentConfigFilePath, StringFormat={}{0}}" Foreground="#64748B" TextTrimming="CharacterEllipsis" FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
