<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Header & Subtitles -->
    <sys:String x:Key="AppTitle">Emulator Auto Updater</sys:String>
    <sys:String x:Key="AppSubtitle">에뮬레이터 통합 자동 업데이트 &amp; 초고속 병렬 다운로더</sys:String>
    <sys:String x:Key="AppUpdateAvailableBadge">⚡ 프로그램 새 버전 {0} 사용 가능 - [업데이트]</sys:String>
    <sys:String x:Key="BtnAppUpdateAvailable">⚡ 프로그램 업데이트 가능</sys:String>
    <sys:String x:Key="LabelLanguage">🌐 언어 / Language:</sys:String>

    <!-- Top Action Buttons -->
    <sys:String x:Key="BtnCheckAllUpdates">전체 업데이트 확인</sys:String>
    <sys:String x:Key="BtnDownloadAllUpdates">전체 다운로드</sys:String>
    <sys:String x:Key="BtnCancelOperation">작업 취소</sys:String>
    <sys:String x:Key="BtnCancelCheck">확인 취소</sys:String>
    <sys:String x:Key="BtnCancelDownload">다운로드 취소</sys:String>
    <sys:String x:Key="TipCheckAllUpdates">목록 내 모든 에뮬레이터의 업데이트를 최대 10개 병렬로 확인합니다.</sys:String>
    <sys:String x:Key="TipDownloadAllUpdates">전체 업데이트 확인 후 최신 빌드를 병렬로 자동 다운로드 및 압축 해제합니다.</sys:String>

    <!-- Action Toolbar Row 0 & 1 -->
    <sys:String x:Key="LblEmulatorGroup">에뮬레이터:</sys:String>
    <sys:String x:Key="BtnAddEmulator">+ 에뮬레이터 추가</sys:String>
    <sys:String x:Key="BtnDeleteSelected">선택 삭제</sys:String>
    <sys:String x:Key="LblConfigFileGroup">설정 파일:</sys:String>
    <sys:String x:Key="BtnLoadSettings">설정 불러오기</sys:String>
    <sys:String x:Key="BtnSaveSettings">설정 저장</sys:String>
    <sys:String x:Key="BtnOpenConfigFile">설정 파일 열기...</sys:String>
    <sys:String x:Key="BtnSaveConfigFileAs">다른 이름으로 저장...</sys:String>
    <sys:String x:Key="ChkCheckAllOnStartup">기동 시 전체 업데이트 확인</sys:String>
    <sys:String x:Key="ChkUseVersionSubfolders">버전/날짜 하위 폴더에 저장</sys:String>
    <sys:String x:Key="TipUseVersionSubfolders">설치 폴더 내에 버전명(없을 경우 Release 날짜)으로 하위 폴더를 생성하여 저장합니다.</sys:String>
    <sys:String x:Key="LblDefaultAssetPattern">기본 Asset Pattern:</sys:String>
    <sys:String x:Key="BtnConvertPattern">패턴 변환</sys:String>
    <sys:String x:Key="TipConvertDefaultPattern">입력된 예시 파일명을 정규식 추천 패턴으로 변환합니다.</sys:String>

    <!-- Left Pane: Emulator List DataGrid -->
    <sys:String x:Key="HeaderEmulatorList">📋 등록된 에뮬레이터 목록</sys:String>
    <sys:String x:Key="ColEmulatorName">에뮬레이터 이름</sys:String>
    <sys:String x:Key="ColStatus">상태</sys:String>
    <sys:String x:Key="ColRepository">Repository / URL</sys:String>
    <sys:String x:Key="ColInstallPath">설치 폴더 경로</sys:String>
    <sys:String x:Key="ColAssetPattern">Asset Pattern (정규식)</sys:String>
    <sys:String x:Key="MenuManageSubfolders">📁 다운로드된 버전 폴더 관리...</sys:String>
    <sys:String x:Key="TipManageSubfolders">선택한 에뮬레이터의 하위 저장 폴더 목록을 조회하고 다중 선택하여 삭제합니다.</sys:String>

    <!-- Right Pane: Selected Emulator Details -->
    <sys:String x:Key="HeaderEmulatorDetail">⚙️ 선택한 에뮬레이터 정보 및 제어</sys:String>
    <sys:String x:Key="LblDetailName">에뮬레이터 명:</sys:String>
    <sys:String x:Key="LblDetailRepo">Repository:</sys:String>
    <sys:String x:Key="LblDetailFolder">설치 폴더:</sys:String>
    <sys:String x:Key="BtnBrowseFolder">폴더 선택</sys:String>
    <sys:String x:Key="LblDetailPattern">Asset Pattern:</sys:String>
    <sys:String x:Key="BtnAutoConvertPattern">패턴 자동 변환</sys:String>
    <sys:String x:Key="TipAutoConvertPattern">입력한 예시 파일명(예: PPSSPPWindows64_1.17.1.zip)을 추천 정규식 패턴으로 변환합니다.</sys:String>
    <sys:String x:Key="LblDetailInstalledVersion">설치된 버전:</sys:String>
    <sys:String x:Key="LblDetailLastDownloaded">마지막 다운로드:</sys:String>
    <sys:String x:Key="BtnCheckUpdate">업데이트 확인</sys:String>
    <sys:String x:Key="BtnDownloadOnly">다운로드</sys:String>
    <sys:String x:Key="BtnDownloadAndExtract">다운로드 + 압축 해제</sys:String>
    <sys:String x:Key="BtnManageSubfolders">📁 하위 폴더 관리</sys:String>
    <sys:String x:Key="LblLatestReleaseVersion">최신 릴리즈 버전:</sys:String>
    <sys:String x:Key="LblFetchSource">조회 방식</sys:String>
    <sys:String x:Key="TxtNoSelection">선택 항목 없음</sys:String>
    <sys:String x:Key="TxtNone">없음</sys:String>

    <!-- Bottom Left: Downloadable Assets List -->
    <sys:String x:Key="HeaderDownloadedFiles">📦 조회된 다운로드 파일 목록</sys:String>
    <sys:String x:Key="BtnCopyFileName">📋 파일명 복사</sys:String>
    <sys:String x:Key="TipCopyFileName">선택한 패치 파일명을 클립보드에 복사합니다.</sys:String>
    <sys:String x:Key="BtnApplyToPattern">🪄 패턴에 반영</sys:String>
    <sys:String x:Key="TipApplyToPattern">선택한 파일명을 추천 Asset Pattern 정규식으로 전환합니다.</sys:String>
    <sys:String x:Key="BtnExcludeFromPattern">🚫 패턴에서 제외</sys:String>
    <sys:String x:Key="TipExcludeFromPattern">선택한 제외 대상 파일명(예: symbols, debug)을 분석하여 패턴에 부정 전방 탐색 제외 조건((?!.*symbols))을 자동으로 추가합니다.</sys:String>
    <sys:String x:Key="MenuCopyFileName">📋 파일명 복사</sys:String>
    <sys:String x:Key="MenuApplyToPattern">🪄 Asset Pattern으로 복사 &amp; 자동 변환</sys:String>
    <sys:String x:Key="MenuExcludeFromPattern">🚫 패턴에서 제외 조건 추가</sys:String>
    <sys:String x:Key="ColFileName">파일 이름</sys:String>
    <sys:String x:Key="ColVersionTag">버전 Tag</sys:String>
    <sys:String x:Key="ColPublishDate">게시 일시</sys:String>

    <!-- Bottom Right: Activity Log Console -->
    <sys:String x:Key="HeaderLogConsole">📊 작업 현황 및 로그 콘솔</sys:String>
    <sys:String x:Key="BtnClearLog">로그 지우기</sys:String>
    <sys:String x:Key="LblCurrentConfigFile">설정 파일:</sys:String>

    <!-- Status Badges & Texts -->
    <sys:String x:Key="StatusUpToDateRoot">최신 (루트폴더)</sys:String>
    <sys:String x:Key="StatusUpToDateSubfolder">최신 ({0})</sys:String>
    <sys:String x:Key="StatusUpdateAvailable">업데이트 가능 ({0})</sys:String>
    <sys:String x:Key="StatusChecking">확인 중...</sys:String>
    <sys:String x:Key="StatusDownloading">다운로드 중...</sys:String>
    <sys:String x:Key="StatusExtracting">압축 해제 중...</sys:String>
    <sys:String x:Key="StatusCheckFailed">조회 실패</sys:String>
    <sys:String x:Key="StatusNoMatch">조건 맞는 파일 없음</sys:String>
    <sys:String x:Key="StatusUnchecked">미확인</sys:String>
    <sys:String x:Key="StatusNotInstalled">미설치</sys:String>

    <!-- Subfolder Manager Window -->
    <sys:String x:Key="SubfolderWindowTitle">하위 버전 폴더 관리자</sys:String>
    <sys:String x:Key="SubfolderHeaderTitle">📁 [{0}] 다운로드된 버전 폴더 관리</sys:String>
    <sys:String x:Key="SubfolderHeaderDesc">에뮬레이터 설치 경로 하위에 보관된 구버전/신버전 개별 폴더를 확인하고 정리합니다.</sys:String>
    <sys:String x:Key="SubfolderRootPath">루트 경로: {0}</sys:String>
    <sys:String x:Key="SubfolderBtnSelectAll">전체 선택</sys:String>
    <sys:String x:Key="SubfolderBtnDeselectAll">전체 해제</sys:String>
    <sys:String x:Key="SubfolderBtnRefresh">새로고침</sys:String>
    <sys:String x:Key="SubfolderSelectionSummary">선택됨: {0}개 폴더 ({1})</sys:String>
    <sys:String x:Key="SubfolderColName">폴더명</sys:String>
    <sys:String x:Key="SubfolderColExe">실행 파일 (.exe)</sys:String>
    <sys:String x:Key="SubfolderColSize">용량</sys:String>
    <sys:String x:Key="SubfolderColDate">생성 일시</sys:String>
    <sys:String x:Key="SubfolderStatusInitial">삭제할 폴더를 선택한 후 [선택 폴더 삭제] 버튼을 누르세요.</sys:String>
    <sys:String x:Key="SubfolderBtnDeleteSelected">🗑️ 선택 폴더 삭제</sys:String>
    <sys:String x:Key="SubfolderBtnClose">닫기</sys:String>
    <sys:String x:Key="SubfolderMsgInvalidFolder">에뮬레이터 설치 폴더가 지정되지 않았거나 디스크에 존재하지 않습니다.</sys:String>
    <sys:String x:Key="SubfolderMsgNotFound">다운로드된 버전 하위 폴더를 찾을 수 없습니다.</sys:String>
    <sys:String x:Key="SubfolderMsgFoundCount">총 {0}개의 버전 하위 폴더를 찾았습니다.</sys:String>
    <sys:String x:Key="SubfolderMsgProcessRunning">선택한 '{0}' 폴더 내의 에뮬레이터 프로세스({1}.exe)가 실행 중입니다.&#10;에뮬레이터를 종료한 후 다시 시도하세요.</sys:String>

    <!-- Logs & Messages -->
    <sys:String x:Key="LogLoadingConfig">설정을 불러오는 중입니다...</sys:String>
    <sys:String x:Key="LogConfigLoaded">설정 파일('{0}')을 불러왔습니다.</sys:String>
    <sys:String x:Key="LogConfigNotFound">설정 파일이 없습니다: {0}</sys:String>
    <sys:String x:Key="LogSavingConfig">설정을 저장하는 중입니다...</sys:String>
    <sys:String x:Key="LogConfigSaved">설정을 저장했습니다: {0}</sys:String>
    <sys:String x:Key="LogEmulatorSelected">'{0}' 항목을 선택했습니다.</sys:String>
    <sys:String x:Key="LogSelectEmulator">에뮬레이터를 선택하세요.</sys:String>
    <sys:String x:Key="LogCheckingSingle">[{0}] 업데이트 정보를 확인하는 중입니다...</sys:String>
    <sys:String x:Key="LogCheckSingleSuccess">[{0}] 최신 릴리즈 확인 완료: v{1} (방식: {2})</sys:String>
    <sys:String x:Key="LogCheckProgress">전체 업데이트 확인 중 ({0}/{1}): {2}</sys:String>
    <sys:String x:Key="LogCheckCompleted">전체 업데이트 확인 완료 (총 {0}개)</sys:String>
    <sys:String x:Key="LogCheckCancelled">전체 업데이트 확인을 취소했습니다.</sys:String>
    <sys:String x:Key="LogDownloadProgress">[2/2단계] 전체 다운로드 중 ({0}/{1}): {2}</sys:String>
    <sys:String x:Key="LogDownloadStarted">[{0}] 다운로드를 시작합니다...</sys:String>
    <sys:String x:Key="LogDownloadExtractStarted">[{0}] 압축 해제 시작: {1}</sys:String>
    <sys:String x:Key="LogDownloadExtractCompleted">[{0}] 다운로드 및 압축 해제 완료: {1}</sys:String>
    <sys:String x:Key="LogDownloadOnlyCompleted">[{0}] 다운로드 완료: {1}</sys:String>
    <sys:String x:Key="LogDownloadCompleted">전체 다운로드 및 압축 해제 작업이 완료되었습니다.</sys:String>
    <sys:String x:Key="LogDownloadCancelled">전체 다운로드를 취소했습니다.</sys:String>
    <sys:String x:Key="LogSkipAlreadyUpToDate">[{0}] 이미 최신 상태이므로 다운로드를 건너땁니다.</sys:String>
    <sys:String x:Key="LogAppUpdateFound">[프로그램 업데이트] 새 버전(v{0})이 출시되었습니다. 상단 버튼을 클릭해 최신 버전으로 갱신하세요.</sys:String>
    <sys:String x:Key="LogDetailedRootUpToDate">루트 폴더 [✓ 최신]</sys:String>
    <sys:String x:Key="LogDetailedSubfolderUpToDate">하위 폴더('{0}') [✓ 최신]</sys:String>
    <sys:String x:Key="LogDetailedBothUpToDate">루트 폴더 [✓ 최신] &amp; 하위 폴더('{0}') [✓ 최신]</sys:String>
    <sys:String x:Key="LogDetailedUpdateRequired">업데이트 필요</sys:String>
    <sys:String x:Key="MsgConfirmDeleteSubfolder">다음 선택된 {0}개 폴더를 정말로 삭제하시겠습니까?&#10;이 작업은 되돌릴 수 없습니다.</sys:String>
    <sys:String x:Key="MsgDeleteComplete">선택한 폴더가 성공적으로 삭제되었습니다.</sys:String>
    <sys:String x:Key="MsgSelectFolderToDelete">삭제할 폴더를 하나 이상 선택해주세요.</sys:String>
    <sys:String x:Key="MsgUpdateSelfSuccess">프로그램이 최신 버전으로 업데이트되었습니다.</sys:String>
    <sys:String x:Key="MsgUpdateSelfDownloading">프로그램 업데이트 다운로드 중 ({0})...</sys:String>
    <sys:String x:Key="MsgUpdateSelfReady">업데이트 파일 준비 완료. 프로그램을 자동 재기동합니다...</sys:String>
    <sys:String x:Key="MsgReady">준비 완료</sys:String>
</ResourceDictionary>
